{
  "name": "vue-chrome-ext",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "buildx": "npm run build:web && npm run build:content && npm run build:background",
    "build": "clear && npm-run-all --parallel build:web build:content build:background",
    "build:web": "vite build",
    "build:content": "vite build --config vite.config.content.js",
    "build:background": "vite build --config vite.config.background.js",
    "watch:web": "vite build --watch",
    "watch:content": "vite build --config vite.config.content.js --watch",
    "watch:background": "vite build --config vite.config.background.js --watch",
    "preview": "vite preview",
    "clear": "rimraf extension/dist",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run",
    "test:v1": "vitest run src/utils/test/email-extractor-v1.test.js",
    "test:v2": "vitest run src/utils/test/email-extractor-v2.test.js",
    "test:v3": "vitest run src/utils/test/email-extractor-v3.test.js",
    "test:v4": "vitest run src/utils/test/email-extractor-v4.test.js"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/vue-fontawesome": "^3.0.8",
    "bootstrap": "^5.3.6",
    "dexie": "^4.2.1",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.21",
    "papaparse": "^5.5.2",
    "uuid": "^11.1.0",
    "vue": "^3.5.13",
    "vue-toastification": "^2.0.0-rc.5",
    "vue3-json-viewer": "^2.2.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^9.27.0",
    "eslint-plugin-vue": "^10.1.0",
    "globals": "^16.1.0",
    "jsdom": "^26.1.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.0.1",
    "sass": "^1.87.0",
    "vite": "^6.0.1",
    "vite-plugin-vue-devtools": "^7.6.5",
    "vitest": "^3.1.3"
  }
}
