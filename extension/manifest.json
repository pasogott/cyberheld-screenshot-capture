{
    "manifest_version": 3,
    "version": "2.2.0",
    "name": "cyberheld",
    "description": "Automatic Screenshot Capture",
    "background": {
        "service_worker": "dist/background/background.js"
    },
    "action": {
        "default_icon": "assets/icon/icon16.png",
        "default_popup": "dist/popup/index.html"
    },
    "options_page": "dist/options/index.html",
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "css": [],
            "js": [
                "dist/content/content.js"
            ]
        }
    ],
    "icons": {
        "128": "assets/icon/icon128.png",
        "16": "assets/icon/icon16.png",
        "48": "assets/icon/icon48.png"
    },
    "permissions": [
        "storage",
        "unlimitedStorage",
        "cookies",
        "notifications",
        "tabs",
        "history",
        "alarms",
        "webRequest",
        "contextMenus"
    ],
    "host_permissions": [
        "<all_urls>"
    ]
}